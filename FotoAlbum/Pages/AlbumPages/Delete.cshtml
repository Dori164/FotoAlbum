@page
@model FotoAlbum.Pages.AlbumPages.DeleteModel

@{
    ViewData["Title"] = "Album törlése";
}

<h1>Album törlése</h1>

<h3>Biztosan törlöd ezt az albumot és a hozzá tartozó képeket?</h3>
<div>
    <h4>FotoAlbum.Models.Album</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Cím</dt>
        <dd class="col-sm-10">@Model.Album.Cim</dd>
        <dt class="col-sm-2">Képek száma</dt>
        <dd class="col-sm-10">@Model.Album.Kep.Count</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Album.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-page="./Index">Mégsem</a>
    </form>
</div>
