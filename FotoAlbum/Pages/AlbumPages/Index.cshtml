@page
@model FotoAlbum.Pages.AlbumPages.IndexModel

@{
    ViewData["Title"] = "Albumok";
}

<h1>Fotóalbumok</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Új album</a>
</p>
<table class="table align-middle">
    <thead>
        <tr>
            <th>Borítókép</th>
            <th>
                Cím
            </th>
            <th>
                Leírás
            </th>
            <th>
                Képek
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Album) {
        <tr>
            <td>
                @{ var cover = item.Kep.OrderByDescending(kep => kep.FeltoltesDatuma).FirstOrDefault(); }
                @if (cover is not null)
                {
                    <img src="@cover.KepUrl" alt="@cover.Cim" width="120" height="80" style="object-fit: cover;" />
                }
                else
                {
                    <span class="text-muted">Nincs kép</span>
                }
            </td>
            <td>
                <strong>@item.Cim</strong>
            </td>
            <td>
                @item.Leiras
            </td>
            <td>@item.Kep.Count</td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.Id">Megnyitás</a> |
                <a asp-page="./Edit" asp-route-id="@item.Id">Szerkesztés</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
